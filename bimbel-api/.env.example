APP_NAME="Bimbel Reng Kraksaan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
# Alamat frontend (CORS / tautan dari email)
FRONTEND_URL=http://127.0.0.1:5173

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL wajib (memakai schema master, academic, website, exam, finance, logs)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bimbel_kraksaan_db
DB_SCHEMA=master,academic,website,public
DB_USERNAME=bimbel_user
DB_PASSWORD=

# Masa berlaku token login (menit). 720 = 12 jam, lalu pengguna harus masuk lagi.
SANCTUM_EXPIRATION=720

# Persetujuan keuangan: single_operator (satu pengelola; setujui sendiri wajib password + alasan)
# atau separated (penyetuju harus akun lain)
FINANCE_APPROVAL_MODE=single_operator

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Akun admin pertama yang dibuat oleh: php artisan db:seed
# (kosongkan SEED_ADMIN_PASSWORD agar dibuatkan password acak yang ditampilkan sekali)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# Rekomendasi rapor AI (Claude) - isi API key dari console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Backup & pemulihan (opsional). Default: storage/app/backups dan program PostgreSQL dari PATH
# BACKUP_PATH=/var/backups/bimbel
# BACKUP_PG_DUMP=/usr/lib/postgresql/16/bin/pg_dump
# BACKUP_PG_RESTORE=/usr/lib/postgresql/16/bin/pg_restore
# BACKUP_PSQL=/usr/lib/postgresql/16/bin/psql
